[settings]
name = "Overture_for_calc"

[fields]

in_register
r0 000
r1 001
r2 010
r3 011
r4 100
r5 101
ram 111

out_register
r0 000
r1 001
r2 010
r3 011
r4 100
r5 101
H 110
ram 111

[instructions]
disp
10110000
# 把H寄存器作为高八位，r0作为低八位，寻址对应的内存，把内存内容发送到数码管

mov %a(out_register), %b(in_register)
10aaabbb
# 将 %b 中的数值写入 %a。注意，当in_register或out_register为ram时，实际硬件读写的是内存中地址为(H<<8)|r0的内容

imm %a:U6(immediate | label)
00aaaaaa
# 将固定值 %a 写入寄存器 r0。

nand
01000000
# 对寄存器 r1 和 r2 的值执行按位与非运算，并将结果存入寄存器 r3。

or
01000001
# 对寄存器 r1 和 r2 的值执行按位或运算，并将结果存入寄存器 r3。

and
01000010
# 对寄存器 r1 和 r2 的值执行按位与运算，并将结果存入寄存器 r3。

nor
01000011
# 对寄存器 r1 和 r2 的值执行按位或非运算，并将结果存入寄存器 r3。

add
01000100
# 将寄存器 r1 和 r2 的值相加，并将结果存入寄存器 r3。

sub
01000101
# 将寄存器 r1 和 r2 的值相减，并将结果存入寄存器 r3。

nop
11000000
# 不执行任何操作。

jmp
11000001
# 无条件跳转至寄存器 r0 的值对应的地址。

jz
11000010
# 当寄存器 r3 的值等于 0 时，跳转至寄存器 r0 的值对应的地址。

jnz
11000011
# 当寄存器 r3 的值不等于 0 时，跳转至寄存器 r0 的值对应的地址。

jl
11000100
# 当寄存器 r3 的值小于 0 时，跳转至寄存器 r0 的值对应的地址。

jge
11000101
# 当寄存器 r3 的值大于等于 0 时，跳转至寄存器 r0 的值对应的地址。

jle
11000110
# 当寄存器 r3 的值小于等于 0 时，跳转至寄存器 r0 的值对应的地址。

jg
11000111
# 当寄存器 r3 的值大于 0 时，跳转至寄存器 r0 的值对应的地址。# 另外注意，键盘会在被按下时，把键码写入内存中的0x00，程序可以访问它。但也因此，汇编代码的第一行应该以“U8 0”开头，给内存留出地方。

ldi %a(out_register) %i:U8(immediate)
11111aaa iiiiiiii
# 这是一个两周期完成的指令，将立即数i发送到寄存器a